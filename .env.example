# Copy to .env and fill in. .env is gitignored; never commit the real URI or tokens.

# Atlas connection string (ask the team for it). Required for the API and for the DB-backed tests.
AIRLOCK_MONGO_URI='mongodb+srv://<user>:<password>@<cluster>.mongodb.net/'
# Database the API uses. Tests ignore this and create throwaway airlock_test_<uuid> databases.
AIRLOCK_DB=airlock

# Only needed to run the API and plugin live. One bearer token per role; any random strings work.
AIRLOCK_URL=http://127.0.0.1:8000
AIRLOCK_TOKEN_OPERATOR=
AIRLOCK_TOKEN_BRIDGE=
AIRLOCK_TOKEN_HOOK=
AIRLOCK_TOKEN_READER=
# JSON map of registered_root_id -> host path; the hooks block writes inside it. Keep the single quotes.
AIRLOCK_ROOTS='{"<registered_root_id>": "/absolute/path/to/repo"}'
