# Copy to .env (gitignored) and fill in. NEVER commit real credentials.

# --- Airlock control plane: the shared MongoDB Atlas cluster ---
# Only Airlock (API + job worker) uses this. Workers/target app must NOT.
AIRLOCK_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=Cluster0
AIRLOCK_DB_NAME=airlock
AIRLOCK_EXECUTION_MODE=local   # local (dev) | container (real isolation)

# --- Target app under test: a SEPARATE MongoDB (never the Airlock cluster) ---
# Its own instance/credentials; the runner uses a fresh disposable DB per run.
TARGET_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
TARGET_DB=target_app
TARGET_SECRET=dev-secret
